# Ollama endpoint (local inference)
OLLAMA_BASE_URL="http://localhost:11434"
DEFAULT_MODEL="llama3.1:8b"

# Application
NODE_ENV="development"
APP_NAME="AI Dungeon Master"

# Database (SQLite by default; can be swapped to postgres later)
DATABASE_URL="file:./dev.db"

# Optional: image generation endpoint (Stable Diffusion / ComfyUI)
IMAGE_PROVIDER_URL=""
IMAGE_PROVIDER_TOKEN=""

# Optional: speech-to-text / text-to-speech providers
STT_PROVIDER_URL=""
TTS_PROVIDER_URL=""

# RAG
EMBEDDING_MODEL="nomic-embed-text"
RAG_TOP_K="8"
